{
  "name": "app_name",
  "version": "0.0.0",
  "private": true,
  "description": "app_description",
  "license": "CC0-1.0",
  "author": "mizdra <pp.mizdra@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizdra/app_name.git"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "!src/test",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "gen": "next typegen",
    "lint": "pnpm run gen && pnpm run --no-bail /^lint:.*/",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint --type-aware --type-check",
    "lint-fix": "pnpm run gen && pnpm run --no-bail gen /^lint-fix:.*/",
    "lint-fix:oxfmt": "oxfmt --write",
    "lint-fix:oxlint": "pnpm run lint:oxlint -- --fix",
    "test": "vitest"
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@mizdra/oxlint-config": "^0.0.1",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.14.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.30.1"
}
