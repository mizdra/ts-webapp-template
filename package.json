{
  "name": "app_name",
  "version": "0.0.0",
  "private": true,
  "description": "app_description",
  "license": "CC0-1.0",
  "author": "mizdra <pp.mizdra@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizdra/app_name.git"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!src/**/__snapshots__",
    "!src/test",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:next": "next dev",
    "dev:cmk": "cmk --watch --preserveWatchOutput",
    "build": "next build",
    "start": "next start",
    "db-migrate": "prisma migrate dev",
    "db-seed": "prisma db seed",
    "db-studio": "prisma studio",
    "gen": "run-s gen:*",
    "gen:next": "next typegen",
    "gen:cmk": "cmk",
    "gen:prisma": "prisma generate",
    "lint": "run-s -c gen lint:*",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint --type-aware --type-check",
    "lint-fix": "run-s -c gen lint-fix:*",
    "lint-fix:oxfmt": "oxfmt --write",
    "lint-fix:oxlint": "pnpm run lint:oxlint -- --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "better-auth": "^1.4.20",
    "better-sqlite3": "^12.6.2",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@css-modules-kit/codegen": "^0.10.0",
    "@mizdra/oxlint-config": "^0.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.14.2",
    "prisma": "^7.4.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@10.30.1"
}
